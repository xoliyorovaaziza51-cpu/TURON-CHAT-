# GEMINI_API_KEY: Required if Gemini API features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for session tokens (auto-generated fallback used in dev if omitted).
JWT_SECRET="change_this_to_a_strong_random_secret"

# SUPABASE: Optional hosted Supabase project credentials for PostgreSQL + Auth + RLS.
# When configured, apply /supabase/schema.sql to your Supabase project.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# LIVEKIT: Required for real-time WebRTC live voice/video media streaming.
# Until configured, rooms operate with real-time WebSocket seats, text chat, gifts, and PK without audio transmission.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# PAYMENT PROVIDER: Optional Payme / Click / Stripe merchant key for verified coin top-ups.
PAYMENT_PROVIDER_KEY=""
